generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  // `User` agora representa o funcionário (domínio).
  // Campos de autenticação (email/senha/role) foram movidos para `Account`.
  createdAt DateTime @default(now())

  pontos  Ponto[]
  // relação opcional para a conta de autenticação vinculada a este funcionário
  account Account?

  @@map("users")
}

model Account {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())

  // opcionalmente vincula a uma entidade `User` (funcionário)
  employeeId Int?  @unique
  employee   User? @relation(fields: [employeeId], references: [id])

  @@map("accounts")
}

model Ponto {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("pontos")
}
